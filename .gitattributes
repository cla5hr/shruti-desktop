# Normalize line endings: LF in repo; scripts must stay LF even on Windows checkouts
* text=auto
*.py text eol=lf
*.sh text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.json text eol=lf
# PowerShell scripts are happier with CRLF
*.ps1 text eol=crlf

# Binary fixtures
*.wav binary
*.mp3 binary
*.m4a binary
*.mp4 binary
*.webm binary
